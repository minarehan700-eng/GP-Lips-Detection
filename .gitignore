# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# .vscode/ is deliberately TRACKED here, not ignored. It carries one shared
# workspace setting that stops the Java extension importing android/ as a
# Gradle project — see "Common Errors and Solutions" in README.md.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Gradle build output. The Flutter build directory is redirected to
# android/build by android/build.gradle.kts, so it needs its own rule —
# the /build/ line above only matches the project root.
android/build/
android/app/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets and local signing
.env
.env.*
*.jks
*.keystore
key.properties
**/google-services.json
**/GoogleService-Info.plist

# Android local SDK paths
**/android/local.properties
**/android/.gradle/

# Flutter generated (often recreated)
.flutter-plugins
*.iml
